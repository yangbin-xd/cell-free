#!/bin/bash
#PBS -N cf_csi_nmse01
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb:gpu_rp6000=False
#PBS -l walltime=01:59:00
#PBS -j oe
#PBS -o /srv/scratch/z5380367/GNN-final/logs/csi_nmse01.pbslog

set -uo pipefail
cd /srv/scratch/z5380367/GNN-final
exec >> /srv/scratch/z5380367/GNN-final/logs/csi_nmse01.out 2>&1

NAME=csi_nmse01
MARKER="result/csi/nmse01/rate_asis_seed0.npy"
SELF=/srv/scratch/z5380367/GNN-final/jobs/csi_nmse01.pbs
QSUB=$(command -v qsub || echo /opt/pbs/bin/qsub)

ATT_FILE=/srv/scratch/z5380367/GNN-final/logs/csi_nmse01.attempt
ATT=$(cat "$ATT_FILE" 2>/dev/null || echo 0)
ATT=$((ATT + 1))
echo "$ATT" > "$ATT_FILE"
echo "=== $NAME | attempt $ATT | host $(hostname) | $(date '+%F %T') ==="

if [ -f "$MARKER" ]; then
    echo "=== $NAME COMPLETE (marker already present) ==="
    exit 0
fi
if [ "$ATT" -gt 20 ]; then
    echo "=== $NAME GAVE UP after 20 attempts ==="
    exit 1
fi

module load python/3.8.15
export PYTHONPATH=.
export PYTHONUNBUFFERED=1
export CF_DATA_ROOT=data/CE_error/nmse01
# evaluate THIS campaign's seed-0 full model, not the archived rerun checkpoints
export CF_MAIN_SIGNAL_TMPL='model/signal_main_seed{seed}.pth'
nvidia-smi --query-gpu=name --format=csv,noheader

if ! python3 -c "import torch; torch.zeros(8, device='cuda').sum().item()" 2>/dev/null; then
    echo "--- GPU unusable by this torch build -- requeueing ---"
    "$QSUB" -a "$(date -d '+3 minutes' +%m%d%H%M)" "$SELF"
    exit 0
fi

python3 ablation/csi_eval.py --seed 0 --label nmse01
rc=$?
if [ $rc -ne 0 ]; then
    echo "=== $NAME FAILED (exit $rc) ==="
    exit $rc
fi
if [ -f "$MARKER" ]; then
    echo "=== $NAME COMPLETE $(date '+%F %T') ==="
    exit 0
fi
echo "=== $NAME FAILED (marker not written) ==="
exit 1
